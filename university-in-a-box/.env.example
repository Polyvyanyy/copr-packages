# Шаблон production; пустые обязательные значения намеренно не дают запустить сервис.
# Для локальной разработки этот файл копировать не нужно. Никогда не используйте VITE_ для секретов.
NODE_ENV=production
# Публичный HTTPS-origin без пути, credentials, query и fragment.
APP_URL=
HOST=127.0.0.1
PORT=3000
# 1 только для одного доверенного reverse proxy; прямой доступ к Node должен быть закрыт.
TRUST_PROXY_HOPS=1
# Постоянный локальный диск. Каталог 0700, файл окружения 0600; не сетевой или эфемерный том.
APP_DATA_DIR=/var/lib/japanese
DATABASE_PATH=/var/lib/japanese/university-in-a-box.sqlite
# Отдельный криптографически случайный секрет: минимум 32 символа, без пробелов.
BETTER_AUTH_SECRET=

# Реальные реквизиты оператора, видимые пользователям.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
# Обязательные версия принятых условий и HTTPS-URL юридически проверенного документа.
# Например, URL собственного /legal/terms, но не заглушка и не реквизиты чужого сервиса.
TERMS_VERSION=
TERMS_URL=

# Обязательны в production. RESEND_FROM — адрес либо Имя <адрес> подтверждённого отправителя.
RESEND_API_KEY=
RESEND_FROM=

# Все три пусты: оплата отключена. Частичная настройка — ошибка запуска.
# Production принимает только live-ключ и соответствующий активный Price: 2000 USD-центов / месяц.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
