[Unit]
Description=University in a Box Japanese
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=japanese
Group=japanese
WorkingDirectory=/opt/japanese/current/university-in-a-box
EnvironmentFile=/etc/japanese/environment
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/japanese
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
